# .pubignore
# This file is used by 'dart pub publish' to exclude files from the package archive.
# Unlike .gitignore, files listed here will remain visible on GitHub.

# Exclude media directory used for README and documentation
assets/media/

# Exclude AI agent rules
AGENTS.md

# Exclude GitHub configuration and templates
.github/

# Exclude IDE and build-related files
.idea/
.vscode/
build/
.dart_tool/

# Exclude package-specific temporary/artifact files
.artifacts/
*.null
coverage/

# Exclude metadata files
.metadata

# Exclude Node.js related files
node_modules/
package.json
package-lock.json
.docusaurus/
docs/
static/

# Exclude E2E testing and rules
maestro/
.maestro/
rules/

# Exclude JNI/FFI generation tools
**/tool/jnigen.dart
**/tool/swiftgen.dart
**/example_ffi/
